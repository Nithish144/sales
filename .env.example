# PostgreSQL connection string. Replace USER, PASSWORD and the database name.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sales_management"

# Port the API listens on
PORT=5000

# Origin(s) allowed to call the API (comma-separated). The Vite dev server runs on 5173.
CLIENT_URL=http://localhost:5173

# Optional: timezone used to decide what "today" is (default Asia/Kolkata)
# APP_TIMEZONE=Asia/Kolkata

# Set to "production" when running the built app (also makes Express serve frontend/dist)
# NODE_ENV=production
